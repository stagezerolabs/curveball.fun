# Server-only values. Supply these through your VPS process manager.
# Local stack runs on RISE Testnet (chain 11155931). Set mainnet (4153 + rpc.risechain.com)
# explicitly when targeting a mainnet deployment.
KEEPER_CHAIN_ID=11155931
KEEPER_RPC_URL=https://testnet.riselabs.xyz
KEEPER_LAUNCHPAD_ADDRESS=
KEEPER_DEPLOYMENT_BLOCK=
KEEPER_PRIVATE_KEY=
KEEPER_POLL_INTERVAL_MS=10000

# Curveball Keeper project. Set through the keeper process manager.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Use curveball-keeper@<deployed-commit-sha> in production.
SENTRY_RELEASE=
# Optional: defaults to 1 locally and 0.1 with NODE_ENV=production.
SENTRY_TRACES_SAMPLE_RATE=
