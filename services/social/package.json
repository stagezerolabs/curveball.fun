{
  "name": "@curveball/social-service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun run --cwd ../../packages/db build && node src/main.mjs",
    "api": "bun run --cwd ../../packages/db build && node src/api.mjs",
    "indexer": "bun run --cwd ../../packages/db build && node src/indexer-runner.mjs",
    "worker": "bun run --cwd ../../packages/db build && node src/worker.mjs",
    "migrate": "bun run --cwd ../../packages/db build && node src/migrate.mjs",
    "test": "bun run --cwd ../../packages/db build && bun test src/*.test.mjs"
  },
  "dependencies": {
    "@curveball/db": "workspace:*",
    "@privy-io/node": "0.36.0",
    "pg": "^8.16.3",
    "viem": "2.57.3"
  }
}
