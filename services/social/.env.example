SOCIAL_DATABASE_URL=postgresql://curveball:change-me@127.0.0.1:5432/curveball_social
# Use Supabase's direct/session connection for migrations; runtime may use the pooler URL above.
SOCIAL_DIRECT_DATABASE_URL=
SOCIAL_RPC_URL=https://rpc.risechain.com
SOCIAL_CHAIN_ID=4153
SOCIAL_CHAIN_NAME=Rise
SOCIAL_NATIVE_SYMBOL=ETH
SOCIAL_FACTORY_ADDRESS=
SOCIAL_ADMIN_ADDRESS=0x5cc42e772f67089b4670eec4dcd904be2f2d511c
# Optional comma-separated role=address entries for extra system accounts not discoverable from the factory.
SOCIAL_PROTOCOL_ACCOUNTS=
SOCIAL_DEPLOYMENT_BLOCK=
SOCIAL_PORT=8787
SOCIAL_ALLOWED_ORIGINS=https://curveball.fun,http://localhost:5173
SOCIAL_PUBLIC_ORIGIN=https://social-api.curveball.fun
PRIVY_APP_ID=
# Server-only. Never prefix this value with VITE_ or expose it to the browser.
PRIVY_APP_SECRET=
SOCIAL_CONFIRMATIONS=2
SOCIAL_POLL_INTERVAL_MS=3000
SOCIAL_LOG_RANGE=2000
SOCIAL_METADATA_REFRESH_MS=300000
SOCIAL_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# HTTPS metadata hosts fetched server-side. IPFS always uses the gateway host above.
SOCIAL_METADATA_HOSTS=gateway.pinata.cloud
SOCIAL_RNS_API_URL=https://api.stage0.xyz/api/public/rns/resolve/address/
SOCIAL_DB_POOL_SIZE=10
SOCIAL_DATABASE_SSL=true
# Supabase signs Postgres TLS with its own root CA; path is relative to services/social.
SOCIAL_DATABASE_CA_FILE=certs/supabase-root-2021.crt
