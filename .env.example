# Set the factory address and deployment block after the fresh deployment.
VITE_CHAIN_ID=4153
VITE_RPC_URL=https://rpc.risechain.com
VITE_LAUNCHPAD_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
# Public Privy application credentials. Never expose PRIVY_APP_SECRET through Vite.
VITE_PRIVY_APP_ID=
# Optional when using a Privy app client configured for this frontend.
VITE_PRIVY_CLIENT_ID=
VITE_SOCIAL_API_URL=
# Wallet allowed to see and open the admin area.
VITE_ADMIN_ADDRESS=0x5cc42e772f67089b4670eec4dcd904be2f2d511c
# Server-only Pinata JWT for artwork uploads. Never prefix this with VITE_ or commit a real value.
PINATA_JWT=

# Mainnet deployment only. Use a private provider endpoint; never commit credentials.
RISE_MAINNET_RPC_URL=
# The testnet deploy target also accepts VITE_RPC_URL when it points to chain 11155931.
RISE_TESTNET_RPC_URL=https://testnet.riselabs.xyz
DEPLOYER_ADDRESS=
OWNER_ADDRESS=
TREASURY_ADDRESS=
# The production script deploys an owner-controlled launch-fee treasury.
LAUNCH_FEE_WEI=1000000000000000
GRADUATION_TARGET_WEI=
