# Set the factory address and deployment block after the fresh deployment.
VITE_CHAIN_ID=4153
VITE_RPC_URL=https://rpc.risechain.com
VITE_LAUNCHPAD_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
# Public WalletConnect Cloud project ID for QR/mobile wallets.
VITE_WALLETCONNECT_PROJECT_ID=
# Server-only Pinata JWT for artwork uploads. Never prefix this with VITE_ or commit a real value.
PINATA_JWT=
