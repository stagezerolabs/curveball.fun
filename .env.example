# The launchpad address and deployment block from deployments/<chainId>/curveball.json.
VITE_CHAIN_ID=4153
VITE_RPC_URL=https://rpc.risechain.com
VITE_LAUNCHPAD_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
# Public WalletConnect Cloud project ID for QR/mobile wallets.
VITE_WALLETCONNECT_PROJECT_ID=
# Server-only Pinata JWT for artwork uploads. Never prefix this with VITE_ or commit a real value.
PINATA_JWT=

# Mainnet deployment only. Use a private provider endpoint; never commit credentials.
RISE_MAINNET_RPC_URL=
# The testnet deploy target also accepts VITE_RPC_URL when it points to chain 11155931.
RISE_TESTNET_RPC_URL=https://testnet.riselabs.xyz
# Mainnet authorities, checked by the deploy preflight: the owner must be a TimelockController
# with a delay whose proposer is CURVE_TIMELOCK_PROPOSER (a multisig); guardian and treasury
# must be contracts. Testnet uses the dot operator for all three.
CURVE_OWNER=
CURVE_TIMELOCK_PROPOSER=
CURVE_GUARDIAN=
CURVE_TREASURY=
# At least 0.01 ether, as wei, and a multiple of 4.
CURVE_GRADUATION_TARGET=
