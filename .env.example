# The launchpad address and deployment block from deployments/<chainId>/curveball.json.
# Local stack runs RISE Mainnet (chain 4153). The root .env supplies every local service.
# VPS deployment uses its separate setup (see deploy/README.md).
VITE_CHAIN_ID=4153
VITE_RPC_URL=https://rpc.risechain.com
VITE_LAUNCHPAD_ADDRESS=0xCD07f89C29E1FAE77EC1a342b5D47D9008E9a72d
VITE_DEPLOYMENT_BLOCK=26659759
# Filled from deployments/<chainId>/icarus-swap-adapter.json after a verified adapter deployment.
VITE_ICARUS_SWAP_ADAPTER=0xaC5018C6d1c0AD74CF67f0EC77b615cdf36F8e7c
VITE_ICARUS_SWAP_ADAPTER_CODE_HASH=0xb48b52fb1da0aecb04e053b67a530ccd48c7dc8b97c8c26433480e04f8c80933
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
VITE_SOCIAL_API_URL=http://localhost:8787
# Wallet allowed to see and open the admin area.
VITE_ADMIN_ADDRESS=0x7e6B1bEfC7dd622c20961140779eF61cd9C62Ce4
# Server-only Pinata JWT for artwork uploads. Never prefix this with VITE_ or commit a real value.
PINATA_JWT=

# Local social API, indexer, and worker. Compose supplies the local Postgres URLs.
# For standalone runs, set both database URLs to your database.
SOCIAL_DATABASE_URL=
SOCIAL_DIRECT_DATABASE_URL=
SOCIAL_RPC_URL=https://rpc.risechain.com
SOCIAL_CHAIN_ID=4153
SOCIAL_CHAIN_NAME="RISE Mainnet"
SOCIAL_NATIVE_SYMBOL=ETH
SOCIAL_LAUNCHPAD_ADDRESS=0xCD07f89C29E1FAE77EC1a342b5D47D9008E9a72d
SOCIAL_ADMIN_ADDRESS=0x7e6B1bEfC7dd622c20961140779eF61cd9C62Ce4
SOCIAL_PROTOCOL_ACCOUNTS=
SOCIAL_DEPLOYMENT_BLOCK=26659759
SOCIAL_PORT=8787
SOCIAL_ALLOWED_ORIGINS=http://localhost:5173
SOCIAL_PUBLIC_ORIGIN=http://localhost:8787
SOCIAL_CONFIRMATIONS=2
SOCIAL_POLL_INTERVAL_MS=3000
SOCIAL_LOG_RANGE=2000
SOCIAL_METADATA_REFRESH_MS=300000
SOCIAL_IPFS_GATEWAY=
SOCIAL_METADATA_HOSTS=
SOCIAL_RNS_API_URL=
SOCIAL_DB_POOL_SIZE=10
SOCIAL_DATABASE_SSL=false
SOCIAL_DATABASE_CA_FILE=
# Server-only signing key for wallet sessions (at least 32 random bytes).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Local keeper. Use a dedicated, funded wallet; never put its key in a VITE_ variable.
KEEPER_CHAIN_ID=4153
KEEPER_RPC_URL=https://rpc.risechain.com
KEEPER_LAUNCHPAD_ADDRESS=0xCD07f89C29E1FAE77EC1a342b5D47D9008E9a72d
KEEPER_DEPLOYMENT_BLOCK=26659759
KEEPER_PRIVATE_KEY=
KEEPER_POLL_INTERVAL_MS=10000

# Different Sentry projects can be configured for backend and keeper.
SENTRY_BACKEND_DSN=
SENTRY_KEEPER_DSN=
SENTRY_ENVIRONMENT=mainnet-local
SENTRY_BACKEND_RELEASE=
SENTRY_KEEPER_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# Mainnet deployment only. Use a private provider endpoint; never commit credentials.
RISE_MAINNET_RPC_URL=
# Alias of a dedicated mainnet Foundry keystore; do not reuse the testnet dot alias.
MAINNET_ACCOUNT=
# The testnet deploy target also accepts VITE_RPC_URL when it points to chain 11155931.
RISE_TESTNET_RPC_URL=https://testnet.riselabs.xyz
# Mainnet roles and the 4 WETH target are pinned in contracts/scripts/Deploy.s.sol.
