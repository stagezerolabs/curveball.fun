# Static frontend connected directly to the deployed V2 RISE Testnet contracts.
VITE_CHAIN_ID=11155931
VITE_RPC_URL=https://testnet.riselabs.xyz
VITE_CONTRACT_VERSION=v2
VITE_LAUNCHPAD_ADDRESS=0x36628AbAC7B2cdcde1A8fa21868AfeCB74660ECf
VITE_DEPLOYMENT_BLOCK=55636468
# Public WalletConnect Cloud project ID for QR/mobile wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# ASD is the test token at 0xaa536Bb436df3D0DfF5b0E9E513560D3491Ec182.
# The deployment Make target records the funded bridge address automatically.
# Override the recorded address only when testing a different bridge.
VITE_ASD_BRIDGE_ADDRESS=
# Set VITE_BETA_ENABLED=false to disable the ASD payment source locally.
