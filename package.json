{
  "name": "curveball",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "workspaces": [
    "contracts",
    "packages/*",
    "services/backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "vite build",
    "build:testnet": "vite build --mode testnet",
    "keeper:graduation": "node --env-file=.env --import ./keeper/src/runtime/instrument.mjs keeper/main.mjs",
    "db:build": "bun run --cwd packages/db build",
    "db:generate": "bun run --cwd packages/db generate",
    "backend:start": "bun run db:build && bun run build:testnet && bun --preload ./services/backend/src/platform/instrument.mjs services/backend/src/entrypoints/main.mjs",
    "backend:migrate": "bun run db:build && bun services/backend/src/entrypoints/migrate.mjs",
    "test": "make test",
    "typecheck": "tsc --noEmit",
    "verify:icarus": "make -C contracts verify-icarus",
    "deploy:testnet:preflight": "make -C contracts testnet-preflight",
    "deploy:testnet": "make -C contracts deploy-testnet",
    "deploy:testnet:record": "DEPLOYMENT_NETWORK=testnet bun contracts/scripts/record-production.ts",
    "deploy:testnet:configure": "DEPLOYMENT_NETWORK=testnet bun contracts/scripts/sync-production-config.ts",
    "deploy:preflight": "make -C contracts production-preflight",
    "deploy:record": "bun contracts/scripts/record-production.ts",
    "deploy:configure": "bun contracts/scripts/sync-production-config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@privy-io/react-auth": "3.50.0",
    "@tanstack/react-query": "5.62.7",
    "@wagmi/core": "2.22.1",
    "echarts": "6.1.0",
    "motion": "^14.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.57.5",
    "wagmi": "2.19.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "5.4.11"
  }
}
