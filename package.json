{
  "name": "curveball",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts"
  ],
  "scripts": {
    "dev": "bun --watch src/server.ts & vite",
    "dev:api": "bun --watch src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun src/server.ts",
    "indexer": "bun src/indexer.ts",
    "seed": "bun src/seed.ts",
    "test": "bun test",
    "test:integration:db": "bun scripts/require-test-env.ts TEST_DATABASE_URL -- bun test --timeout 30000 src/db/db.test.ts && bun scripts/require-test-env.ts TEST_DATABASE_URL -- bun test --timeout 30000 src/marketStats.test.ts",
    "test:integration:sdk": "bun scripts/require-test-env.ts SDK_TESTNET_FORK_RPC_URL SDK_TESTNET_FORK_LAUNCHPAD SDK_TESTNET_FORK_ACCOUNT -- bun test src/sdk/wagmiSdk.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verify:icarus": "make -C contracts verify-icarus-testnet"
  },
  "dependencies": {
    "@neon/config": "^1.7.1",
    "@tanstack/react-query": "5.62.7",
    "@neon/env": "^1.4.2",
    "@wagmi/core": "2.16.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.6.14",
    "postgres": "3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.21.52",
    "wagmi": "2.14.11",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "drizzle-kit": "0.31.10",
    "typescript": "5.7.3",
    "vite": "5.4.11"
  }
}
