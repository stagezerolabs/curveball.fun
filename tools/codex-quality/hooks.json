{
  "description": "Risk-tiered verification, focus preservation, and independent review enforcement.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py session_start",
            "timeout": 30,
            "statusMessage": "Loading verification contract"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py user_prompt_submit",
            "timeout": 10,
            "statusMessage": "Recording task objective"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py pre_tool_use",
            "timeout": 10,
            "statusMessage": "Checking for unsafe shortcuts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py post_tool_use",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py pre_compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py post_compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^quality_reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py subagent_stop",
            "timeout": 30,
            "statusMessage": "Validating independent review"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py stop",
            "timeout": 600,
            "statusMessage": "Running completion gates"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/macbook/.codex/hooks/quality_gate.py session_end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
